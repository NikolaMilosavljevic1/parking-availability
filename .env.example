# =============================================================================
# Belgrade Parking — environment template
#
# Copy this file to .env and set your values:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# =============================================================================

# Required — docker-compose will fail without this
POSTGRES_PASSWORD=changeme

# Optional overrides (defaults shown)
POSTGRES_DB=parking
POSTGRES_USER=parking

# -----------------------------------------------------------------------------
# Only needed when running Python scripts OUTSIDE Docker (on your host machine).
# Inside containers, docker-compose sets these automatically.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://parking:changeme@localhost:5432/parking
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional — protects POST /events in production (Phase C3, not yet enforced)
# -----------------------------------------------------------------------------
# ADMIN_API_KEY=your_random_secret
