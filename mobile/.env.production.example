# Production API URL — used when building a standalone APK (EAS Build).
# Copy values from your Cloudflare Tunnel URL (https://...) before running eas build.
#
# Set these in the Expo dashboard or via CLI (recommended — not committed):
#   eas env:create --name EXPO_PUBLIC_API_URL --value https://YOUR-TUNNEL-URL --environment preview --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_WS_URL --value wss://YOUR-TUNNEL-URL/ws/live --environment preview --visibility plaintext
#
# Or export locally before a local Gradle build:
EXPO_PUBLIC_API_URL=https://YOUR-TUNNEL-URL
EXPO_PUBLIC_WS_URL=wss://YOUR-TUNNEL-URL/ws/live
