{
  "expo": {
    "name": "Belgrade Parking",
    "slug": "belgrade-parking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.belgradepark.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to calculate your distance to parking locations.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "maps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      },
      "package": "com.belgradepark.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to calculate your distance to parking locations."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8a84aaa8-dfcc-45b0-8c3b-11ee0eca698f"
      }
    },
    "owner": "niksi02"
  }
}
